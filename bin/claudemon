#!/usr/bin/env node

import { mkdirSync, watch } from 'node:fs'
import { basename } from 'node:path'
import { createApp } from '../src/app.mjs'
import { loadConfig } from '../src/config.mjs'
import {
  DATASET_MISSING_HINT,
  DATASET_MISSING_MESSAGE,
  FRAME_MS,
  HEARTBEAT_MS,
  POLL_MS,
  TICK_MS,
  UPDATE_POLL_MS,
} from '../src/constants.mjs'
import { isDataReady } from '../src/data.mjs'
import { HOME, QUEUE_FILE } from '../src/paths.mjs'
import { loadSave, publishStatus } from '../src/state.mjs'
import { bold, brightYellow, dim } from '../src/ui/ansi.mjs'
import { createScreen } from '../src/ui/screen.mjs'

const bail = (message, hint) => {
  process.stderr.write(
    `\n  ${brightYellow('◓')} ${bold('claudemon')}\n\n  ${message}\n`,
  )

  if (hint) process.stderr.write(`  ${dim(hint)}\n`)

  process.stderr.write('\n')
  process.exit(1)
}

const main = () => {
  if (!isDataReady()) bail(DATASET_MISSING_MESSAGE, DATASET_MISSING_HINT)

  mkdirSync(HOME, { recursive: true })

  const config = loadConfig()
  const save = loadSave()
  const screen = createScreen({ input: process.stdin, output: process.stdout })
  const app = createApp({ screen, save, config })

  const handleResize = () => {
    screen.repaint()
    app.paint()
  }

  const handleUpdateChecked = (changed) => {
    if (changed) app.paint()
  }

  const tickHeartbeat = () => {
    if (app.save) publishStatus(app.save)
  }

  const handleQueueChange = (_event, filename) => {
    if (filename !== basename(QUEUE_FILE)) return
    if (app.pump()) app.paint()
  }

  const pollActivity = () => {
    const arrived = app.pump()
    const activityChanged = app.refreshActivity()

    if (arrived || activityChanged || app.activity.state === 'working')
      app.paint()
  }

  const tickBlinkOrEncounter = () => {
    if (app.mode === 'starter' && app.setup.step === 'name') {
      app.setup.blink = !app.setup.blink
      app.paint()
      return
    }

    if (app.encounter) {
      app.pump()
      app.paint()
    }
  }

  const tickFrames = () => {
    if (app.tickBattle() || app.tickScene() || app.tickUpdate()) app.paint()
  }

  const pollUpdates = () => {
    if (app.refreshUpdateNotice()) app.paint()

    app.checkForUpdates().then(handleUpdateChecked)
  }

  screen.start()
  screen.onResize(handleResize)
  screen.onKey(app.handleKey)

  app.pump()
  app.refreshActivity()
  app.paint()

  if (app.save) publishStatus(app.save)

  app.checkForUpdates({ atLaunch: true }).then(handleUpdateChecked)

  const heartbeat = setInterval(tickHeartbeat, HEARTBEAT_MS)

  try {
    watch(HOME, handleQueueChange)
  } catch {}

  const poll = setInterval(pollActivity, POLL_MS)

  const tick = setInterval(tickBlinkOrEncounter, TICK_MS)

  const frames = setInterval(tickFrames, FRAME_MS)

  const updates = setInterval(pollUpdates, UPDATE_POLL_MS)

  for (const timer of [heartbeat, poll, tick, frames, updates]) timer.unref()

  process.stdin.resume()
}

main()
